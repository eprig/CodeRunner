# Shared by both image builds (context = repo root):
#   containers/code/Dockerfile    needs containers/code/, catalog/
#   containers/control/Dockerfile needs package.json, bun.lock, tsconfig*,
#     apps/, packages/, scripts/, catalog/, vendor/, patches/, and the
#     submodule gitdir .git/modules/vendor/AdvantageScope (for the
#     AdvantageScope patch/symlink steps).

# Git metadata, except the AdvantageScope submodule gitdir.
.git
!.git/modules/vendor/AdvantageScope
# ...but only the parts the AdvantageScope build reads (HEAD, config, index,
# refs, objects; build-ascope-lite.ts lists symlinks with `git ls-files`). The
# rest changes without the code changing (reflogs on every checkout,
# FETCH_HEAD, editor/GUI tool folders) and would invalidate the cached wasm
# compile. scripts/image.ts usually skips that stage entirely by reusing a
# prebuilt AdvantageScope (scripts/ascope-prebuilt.ts).
.git/modules/vendor/AdvantageScope/logs
.git/modules/vendor/AdvantageScope/hooks
.git/modules/vendor/AdvantageScope/info
.git/modules/vendor/AdvantageScope/gk
.git/modules/vendor/AdvantageScope/description
.git/modules/vendor/AdvantageScope/FETCH_HEAD
.git/modules/vendor/AdvantageScope/ORIG_HEAD
.git/modules/vendor/AdvantageScope/**/*.lock

# Dependencies and build outputs (regenerated inside the build stages).
node_modules
**/node_modules
dist
apps/web/dist

# Runtime and local-only data.
.cache
data
*.env
.env*

# Not used by any image. (*.md is root-level only — catalog lesson READMEs
# under catalog/ still ship in both images. THIRD_PARTY_NOTICES.md is the one
# exception: BSD-3-Clause requires the notice to accompany the binary
# distribution, and the images are that distribution. Extensionless LICENSE is
# not matched by *.md and needs no negation.)
website
docs
dashboards
deploy
e2e
lessons-repo-root
graphify-out
test-results
playwright-report
.github
.claude
*.md
!THIRD_PARTY_NOTICES.md
